<% if (blogs.length) { %>
    <% blogs.forEach(blog => { %>
        <div class="bg-white rounded-md overflow-hidden shadow-md">
            <a href="<%= blog.getUrl() %>">
                <img class="w-full h-48 object-cover transform transition-all duration-500 hover:scale-105"
                     src="<%= blog.getThumbnail() %>" alt="<%= blog.getTitle() %>">
            </a>
            <div class="px-6 py-4">
                <a href="<%= blog.getUrl() %>">
                    <div class="font-bold text-xl mb-2"><%= blog.getTitle() %></div>
                </a>
                <p class="text-gray-700 text-base"><%= blog.getSubTitle() %></p>
            </div>
            <div class="px-6 py-4 flex items-center justify-around space-x-2 text-sm">
                <div class="flex flex-row items-center justify-around space-x-2">
                    <div class="flex-shrink-0">
                        <span class="flex items-center text-blue-600"><i class="fas fa-clock mr-2"></i><span
                                    class="font-bold pr-1"></span> <%= blog.calculateEstimatedReadTime() %> Mins</span>
                    </div>
                    <div class="flex-shrink-0">
                        <span class="flex items-center text-yellow-600"><i class="fas fa-eye mr-2"></i><span
                                    class="font-bold pr-1"></span> <%= blog.getReadVisits() %></span>
                    </div>
                    <div class="flex-shrink-0">
                        <span class="flex items-center text-blue-800"><i class="fas fa-book mr-2"></i><span
                                    class="font-bold pr-1"></span> <%= blog.getTotalWordsCount() %> word</span>
                    </div>
                </div>
            </div>
        </div>
    <% }) %>
<% } else { %>
    No Data
<% } %>