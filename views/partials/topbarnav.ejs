        <nav>
            <ul class="flex items-center justify-between font-bold text-sm text-white uppercase no-underline">
                <li><a class="hover:text-gray-200 hover:underline px-4" href="/blogs">Blogging Tools </a></li>
                <%if(isLogedIn) { %>
