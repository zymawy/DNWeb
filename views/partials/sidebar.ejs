<style>
    .share-btn > a {
        border: 1px solid #ccc;
        padding: 5px;
        font-size: 12px;
        font-family: Verdana, Arial;
    }
    .share-btn > a:hover {
        cursor: pointer;
    }
</style>
<aside class="w-full md:w-1/3 flex flex-col items-center px-3">
    <div class="w-full bg-white shadow flex flex-col my-4 p-6">
        <h2 class="text-lg font-bold pb-4">Detail</h2>
        <div class="text-sm pb-8 flex flex-col space-y-2">
     <span class="flex items-center text-green-600">
         <i class="fas fa-user mr-2"></i><span class="font-bold pr-1">By:</span> <a href="#" class="font-semibold hover:text-gray-800"><%= blog?.user ? blog?.user?.getFullName() : 'Admin' %></a>
     </span>
            <span class="flex items-center text-purple-700">
         <i class="fas fa-timestamp mr-2"></i><span class="font-bold pr-1">Published On:</span> <%= blog.getPublishedAt() %>
     </span>
            <span class="flex items-center text-blue-600">
         <i class="fas fa-clock mr-2"></i><span class="font-bold pr-1">Read Time: </span> <%= blog.calculateEstimatedReadTime() %> Mins
     </span>
            <span class="flex items-center text-yellow-600">
         <i class="fas fa-eye mr-2"></i><span class="font-bold pr-1">Visits:</span> <%= blog.getReadVisits() %>
     </span>
            <span class="flex items-center text-blue-800">
         <i class="fas fa-book mr-2"></i><span class="font-bold pr-1">Words:</span> <%= blog.getTotalWordsCount() %> word
     </span>
        </div>

        <div>
            <h2 class="text-lg font-bold py-4">Tags</h2>
            <% blog.tags.forEach(tag => { %>
                <a href="/tags/<%= tag?.attributes?.id %>-<%= tag?.attributes?.name %>" class="inline-block bg-red-200 rounded-full px-3 py-1 text-sm font-semibold text-gray-700 mr-2 mb-2"><%= tag?.attributes?.name %></a>
            <% }); %>
        </div>

    </div>
    <div class="w-full bg-white shadow flex flex-col my-4 p-6">
        <h2 class="text-lg font-bold pb-4">Share </h2>
        <div class="a2a_kit a2a_kit_size_32 a2a_default_style blog-single__share-icons">
            <a class="share-icon a2a_button_twitter"></a>
            <a class="share-icon a2a_button_facebook"></a>
            <a class="share-icon a2a_button_copy_link"></a>
        </div>

        <script type="text/javascript">
            var a2a_config = a2a_config || {};
            a2a_config.linkurl = "<%= locals.host + blog.getUrl() %>";
        </script>
        <script async="" src="https://static.addtoany.com/menu/page.js"></script>
    </div>
    <div class="w-full bg-white shadow flex flex-col my-4 p-6">
            <button id="emojis-needed" class="flex items-center text-blue-800">
                <i class="fas fa-icons mr-2"></i>
            </button>
        <div id="emojis">
        </div>
    </div>

</aside>