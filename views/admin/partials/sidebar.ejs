<div class="w-full md:w-1/3 px-3">
    <div class="bg-white rounded shadow p-6">
        <h2 class="text-2xl font-bold mb-6">Sidebar</h2>
        <div class="mb-6">
            <label for="status" class="block text-lg font-bold mb-2">Status</label>
            <select id="status" name="status"
                    class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500"
                    form="create-post"
            >
                <option value="drafted">Drafted</option>
                <option value="published">published</option>
            </select>
            <div id="status_error" class="email error show_info text-sm mb-4 w-max text-red-400"></div>
        </div>

        <div class="mb-6">
            <% if(locals.post) { %>
                <img class="w-full h-64 object-cover" src="<%= locals.post.getThumbnail() %>" alt="Blog image">
            <% } %>

            <label for="image" class="block text-lg font-bold mb-2">Image Uploader:</label>
            <input form="create-post" type="file" id="image" name="image" class="w-full">
            <div id="image_error" class="email error show_info text-sm mb-4 w-max text-red-400"></div>
        </div>
        <div class="mb-6">
            <label for="tags" class="block text-lg font-bold mb-2">Tags:</label>
            <select id="tags" name="tags"
                    class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500"
                    multiple=""
                    data-type="tags"
            >
                <% tags.forEach(tag => { %>
                    <option value="<%= tag?.attributes?.id %>" <%= locals.postTags && locals.postTags.includes(tag?.attributes?.id) ? 'selected' : '' %>>
                        <%= tag?.attributes?.name %>
                    </option>
                <% }); %>
            </select>
            <div id="tags_error" class="email error show_info text-sm mb-4 w-max text-red-400"></div>
        </div>
        <div class="mb-6">
            <label for="categories" class="block text-lg font-bold mb-2">Categories:</label>
            <select id="categories" name="categories"
                    class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500"
                    multiple data-type="categories">
                <% categories.forEach(category => { %>
                    <option value="<%= category?.attributes?.id %>"
                            <%= locals.postCategory && locals.postCategory.includes(category?.attributes?.id) ? 'selected' : '' %>
                    >
                        <%= category?.attributes?.name %>
                    </option>
                <% }); %>
            </select>
            <div id="categories_error" class="email error show_info text-sm mb-4 w-max text-red-400"></div>
        </div>
    </div>
</div>