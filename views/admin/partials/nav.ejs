<!-- Topic Nav -->
<nav class="w-full py-4 border-t border-b bg-gray-100" x-data="{ open: false }">
    <div class="block sm:hidden">
        <a
                href="#"
                class="block md:hidden text-base font-bold uppercase text-center flex justify-center items-center"
                @click="open = !open"
        >
            Topics <i :class="open ? 'fa-chevron-down': 'fa-chevron-up'" class="fas ml-2"></i>
        </a>
    </div>
    <div :class="open ? 'block': 'hidden'" class="w-full flex-grow sm:flex sm:items-center sm:w-auto">
        <div class="w-full container mx-auto flex flex-col sm:flex-row items-center justify-center text-sm font-bold uppercase mt-0 px-6 py-2">
            <a href="/" class="hover:bg-gray-400 bg-blue-400 rounded py-2 px-4 mx-2"><i class="fas fa-blog"></i> Visit Blog</a>
            <a href="/admin" class="hover:bg-gray-400 rounded py-2 px-4 mx-2"><i class="fas fa-blog"></i> Blogs</a>
            <a href="/admin/blogs/comments" class="hover:bg-gray-400 rounded py-2 px-4 mx-2"><i class="fas fa-comments"></i> Comments</a>
            <a href="/admin/categories" class="hover:bg-gray-400 rounded py-2 px-4 mx-2"><i class="fas fa-code-merge"></i> Categories</a>
            <a href="/admin/tags" class="hover:bg-gray-400 rounded py-2 px-4 mx-2"><i class="fas fa-code-merge"></i> Tags</a>
            <a href="/admin/blogs/users" class="hover:bg-gray-400 rounded py-2 px-4 mx-2"><i class="fas fa-users"></i>Users</a>
            <a href="/admin/settings" class="hover:bg-gray-400 rounded py-2 px-4 mx-2">
                <button class="flex items-center text-sm font-medium text-gray-900 rounded-full hover:text-blue-600 dark:hover:text-blue-500 md:mr-0 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:text-white" type="button">
                    <img class="w-8 h-8 mr-2 rounded-full" src="<%= currentUser.getThumbnail() %>" alt="user photo">
                    <%= currentUser.getFullName() %>
                </button>
            </a>
        </div>
    </div>
</nav>
