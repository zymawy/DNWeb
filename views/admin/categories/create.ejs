<%- include('../partials/header.ejs') %>

<%- include('../partials/nav.ejs') %>

<div class="container mx-auto py-6">
    <div class="flex flex-wrap px-3">
        <div class="w-full">
            <div class="bg-white rounded shadow p-6">
                <h2 class="text-2xl font-bold mb-6">Create Category</h2>

                <form id="create-post" action="/admin/blogs/create">
                        <input type="hidden" id="category_id" value="<%= locals.category ? locals.category.getId() : '' %>" name="category_id" />
                    <div class="mb-6">
                        <label for="title" class="block text-lg font-bold mb-2">Category Title:</label>
                        <input value="<%= locals.category ? locals?.category?.getTitle() : '' %>"
                                type="text" id="title" name="title" class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500">
                        <div id="title_error" class="email error show_info text-sm mb-4 w-max text-red-400"></div>
                    </div>
                    <button type="submit" class="bg-blue-500 text-white px-6 py-3 rounded hover:bg-blue-600">Submit</button>
                </form>
            </div>
        </div>
    </div>

</div>


<script>

    const form = document.getElementById('create-post')

    form.addEventListener('submit', function (evt)  {
        evt.preventDefault();

        const title = document.querySelector('input#title').value;
        const categoryId = document.querySelector('input#category_id').value;
        console.log(title, categoryId)

        const data = {title}
        let uri = `/admin/categories`,
        method = 'POST';
        if (categoryId) {
            uri += `/${categoryId}`
            method = "PATCH"
        }

        fetch(uri, {
            method: method,
            body: JSON.stringify(data),
            headers: { 'Content-Type': 'application/json'}
        })
            .then(async data => {
                const response = await data.json();
                console.log(response)
                const { status } = data;

                if (status === 422 && response.errors) {
                    // let's clean the old data error...
                    document.querySelectorAll('.error').forEach((el) => {
                        el.textContent =  '';
                    })
                    response.errors
                        .forEach((error,k) => {
                            document.getElementById(`${error.path}_error`).textContent =  '';
                            document.getElementById(`${error.path}_error`).textContent =  error.msg;
                        })

                    return;
                }

                alert('Category Added Successfully 🎉');

                location.assign('/admin/categories');
            })
            .catch(error => {
                console.error('Error:', error);
            });
    });
</script>
<%- include('../partials/footer.ejs') %>
