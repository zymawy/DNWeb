<%- include('../partials/header.ejs') %>
<%- include('../partials/nav.ejs') %>

<section class="flex flex-col items-center justify-center py-8 mx-auto">
        <div class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
            <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
                <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">
                    Sign in to your account
                </h1>
                <form class="space-y-4 md:space-y-6" action="#">
                    <div>
                        <label for="email" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Your email</label>
                        <input type="email" name="email" id="email" class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" placeholder="name@company.com" required="">
                        <div id="email_error" class="email error show_info text-sm mb-4 w-max text-red-400"></div>
                    </div>
                    <div>
                        <label for="password" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Password</label>
                        <input type="password" name="password" id="password" placeholder="••••••••" class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" required="">
                        <div id="password_error" class="password error show_info text-sm mb-4 w-max text-red-400"></div>
                    </div>
                    <div class="flex items-center justify-between">
                        <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="submit">
                            <i id="submitButtonIcon" class="fas fa-user-plus"></i>
                            Login
                        </button>
                    </div>
                    <p class="text-sm font-light text-gray-500 dark:text-gray-400">
                        Don’t have an account yet? <a href="/auth/register" class="font-medium text-primary-600 hover:underline dark:text-primary-500">Sign up</a>
                    </p>
                </form>
            </div>
        </div>
</section>

<script>
    const form = document.querySelector('form');

    form.addEventListener('submit', async (evt) => {
        evt.preventDefault();
        const submitButtonIcon = document.getElementById('submitButtonIcon');
        submitButtonIcon.classList.remove('fa-user-plus');
        submitButtonIcon.classList.add('fa-spinner', 'fa-spin');

        const email = form.email.value;
        const password = form.password.value;

        const emailError = document.querySelector('.email.error');
        const passwordError = document.querySelector('.password.error');

        try {
            const res = await fetch('/auth/login', {
                method:'post',
                body: JSON.stringify({email,password}),
                headers: { 'Content-Type': 'application/json'}
            })
            const data = await res.json()

            const { status } = res;

            if (status === 422 && data.errors) {
                passwordError.textContent = ''
                emailError.textContent = ''
                data.errors
                    .forEach((error,k) => {
                        document.getElementById(`${error.path}_error`).textContent =  '';
                        document.getElementById(`${error.path}_error`).textContent =  error.msg;
                    })
            }

            if (data.user) {

                if (data.user.is_admin) {
                    location.assign('/admin');
                } else {
                    location.assign('/');
                }
            }

            submitButtonIcon.remove();
            submitButtonIcon.classList.add('fa-user-plus');

        } catch (e) {
        }

    });
</script>

<%- include('../partials/footer.ejs') %>
